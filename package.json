{
  "name": "hq",
  "version": "0.1.0",
  "private": true,
  "description": "Your personal HQ — a local command center for applications, work, wellbeing and more.",
  "author": "Pranshu Pandey",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3411",
    "lint": "eslint",
    "mcp": "node mcp/hq-mcp.mjs",
    "mcp:http": "node mcp/hq-http.mjs",
    "postinstall": "prisma generate",
    "desktop": "electron electron/main.js",
    "dist:mac": "electron-builder --mac --dir",
    "dist:install": "npm run dist:mac && codesign --force --deep --sign - dist-desktop/mac-arm64/HQ.app && rm -rf /Applications/HQ.app && cp -R dist-desktop/mac-arm64/HQ.app /Applications/HQ.app",
    "dist:update": "node scripts/update-desktop.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1109.0",
    "@libsql/client": "^0.17.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/adapter-libsql": "^6.19.3",
    "@prisma/client": "6.19.3",
    "@tiptap/extension-image": "3.27.3",
    "@tiptap/extension-mention": "3.27.3",
    "@tiptap/extension-placeholder": "^3.27.3",
    "@tiptap/extension-underline": "^3.27.3",
    "@tiptap/pm": "^3.27.3",
    "@tiptap/react": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "web-push": "3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "3.6.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
